# Salin ke .env lalu isi. Jangan commit file .env.
NODE_ENV=development
PORT=4000

# Minimal 32 karakter. Generate: openssl rand -hex 32
# Boleh lebih dari satu (dipisah koma) untuk rotasi key tanpa downtime.
API_KEYS=ganti-dengan-hasil-openssl-rand-hex-32

# Origin browser yang boleh memanggil API langsung (opsional, dipisah koma).
CORS_ORIGINS=

CATALOG_UPSTREAM_URL=https://dummyjson.com
CATALOG_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# KODE:persen, dipisah koma
PROMO_CODES=HEMAT10:10

THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
